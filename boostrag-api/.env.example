OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# --- Hybrid retrieval knobs (all optional; defaults shown) ---
# MAX_DISTANCE=0.95        # corpus "good enough" cutoff. Calibrated 2026-07-04:
#                          # in-corpus queries measured 0.48-0.89, out-of-corpus 0.99-1.73.
# MIN_STRONG_CHUNKS=1      # how many chunks must be within MAX_DISTANCE to answer from corpus
# WEB_QUERY_EXPANSION=2    # cap Tavily sub-queries per question (free-tier conservation)
# DAILY_WEB_SEARCH_CAP=15  # hard daily web-search fuse (cost safety)
# AUTO_INGEST_MIN_SCORE=9  # trust-score gate for auto-ingesting a live source into the corpus
# CACHE_TTL_HOURS=24       # answer cache lifetime

# --- Deployment knobs (optional; local defaults shown) ---
# BOOSTRAG_DATA_DIR=.                                          # storage root; set to a persistent disk mount in prod
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173  # CORS allowlist; set to your deployed frontend URL in prod
# DAILY_ASK_CAP=500        # global daily /ask cap (all visitors)
# RATE_LIMIT=20/minute     # per-IP rate limit on /ask
# AUTO_INGEST_ENABLED=true # master switch for the auto-ingest flywheel
